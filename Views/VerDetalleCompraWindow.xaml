<Window x:Class="Libreria_Rembooks.Views.VerDetalleCompraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Detalle de Compra"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BOTONES SUPERIORES -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">

            <TextBlock Text="Detalle de Compra"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">

                <Button Content="🖨 Imprimir / PDF"
                        Width="150"
                        Height="35"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Margin="0,0,10,0"
                        Click="btnImprimirPdf_Click"/>

                <Button Content="Cerrar"
                        Width="100"
                        Height="35"
                        Background="#E5E7EB"
                        BorderThickness="0"
                        Click="btnCerrar_Click"/>

            </StackPanel>

        </DockPanel>

        <!-- FACTURA -->
        <Border Grid.Row="1"
                x:Name="FacturaPanel"
                Background="White"
                CornerRadius="10"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="25">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ENCABEZADO FACTURA -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="LIBRERÍA REMBOOKS"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock Text="Registro de compra de productos"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#F3F4F6"
                            CornerRadius="8"
                            Padding="15">

                        <StackPanel>
                            <TextBlock Text="COMPRA"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding CompraSeleccionada.Numero_Documento}"
                                       FontSize="14"
                                       Foreground="#374151"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                    </Border>

                </Grid>

                <!-- DATOS COMPRA -->
                <Border Grid.Row="2"
                        Background="#F9FAFB"
                        CornerRadius="8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="15">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Proveedor"
                                       FontWeight="Bold"
                                       Foreground="#374151"/>

                            <TextBlock 
                                       x:Name="txtRazonSocial"
                                       Text=""
                                       FontSize="14"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="No. Documento"
                                       FontWeight="Bold"
                                       Foreground="#374151"/>

                            <TextBlock 
                                       x:Name="txtNoDocumento"
                                       Text=""
                                       FontSize="14"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Serie"
                                       FontWeight="Bold"
                                       Foreground="#374151"/>

                            <TextBlock 
                                       x:Name="txtSerie"
                                       Text=""
                                       FontSize="14"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Fecha Emisión"
                                       FontWeight="Bold"
                                       Foreground="#374151"/>

                            <TextBlock 
                                       x:Name="txtFechaEmision"
                                       Text=""
                                       FontSize="14"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                    </Grid>

                </Border>

                <!-- TABLA DETALLE -->
                <DataGrid Grid.Row="4"
                          x:Name="dgDetalleCompras"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          RowHeight="32"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Producto"
                                            Binding="{Binding Producto.Nombre}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Cantidad"
                                            Binding="{Binding Cantidad}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Precio Unitario"
                                            Binding="{Binding Precio_Unitario, StringFormat=Q {0:N2}}"
                                            Width="140"/>

                        <DataGridTextColumn Header="Subtotal"
                                            Binding="{Binding Subtotal, StringFormat=Q {0:N2}}"
                                            Width="140"/>

                    </DataGrid.Columns>

                </DataGrid>

                <!-- TOTAL -->
                <Grid Grid.Row="6">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Documento generado desde el sistema de compras."
                               Foreground="#6B7280"
                               VerticalAlignment="Bottom"/>

                    <Border Grid.Column="1"
                            Background="#F9FAFB"
                            CornerRadius="8"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="15">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="TOTAL: "
                                       FontSize="18"
                                       FontWeight="Bold" Margin="0,0,182,0"/>
                            <TextBlock Text=" "
                                     x:Name="txtblock_Total"
                                     FontSize="18"
                                     FontWeight="Bold" Margin="89,1,10,0" RenderTransformOrigin="0.283,0.363"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding CompraSeleccionada.total, StringFormat=Q {0:N2}}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#16A34A"/>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </Border>

        <!-- PIE -->
        <TextBlock Grid.Row="2"
                   Text="Vista previa de detalle de compra"
                   Foreground="#6B7280"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>

    </Grid>

</Window>