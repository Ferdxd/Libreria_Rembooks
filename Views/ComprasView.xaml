<UserControl x:Class="Libreria_Rembooks.Views.ComprasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100"
             Background="#F3F4F6">

    <UserControl.Resources>

        <!-- ================= ESTILO DE TEXTBOX ================= -->
        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Padding"
                    Value="9,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12.5"/>

        </Style>

        <!-- ================= ESTILO DE LABEL ================= -->
        <Style x:Key="InputLabelStyle"
               TargetType="Label">

            <Setter Property="Foreground"
                    Value="#374151"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="11.5"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="0,0,0,5"/>

        </Style>

        <!-- ================= BOTÓN PRINCIPAL ================= -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

        <!-- ================= BOTÓN VERDE ================= -->
        <Style x:Key="SuccessButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="Background"
                    Value="#16A34A"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

        <!-- ================= BOTÓN SECUNDARIO ================= -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="Background"
                    Value="#E5E7EB"/>

            <Setter Property="Foreground"
                    Value="#111827"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

        <!-- ================= ENCABEZADOS DATAGRID ================= -->
        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F3F4F6"/>

            <Setter Property="Foreground"
                    Value="#374151"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="BorderBrush"
                    Value="#E5E7EB"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

        </Style>

        <!-- ================= CELDAS DATAGRID ================= -->
        <Style TargetType="DataGridCell">

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- ================= FILAS DATAGRID ================= -->
        <Style TargetType="DataGridRow">

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </UserControl.Resources>

    <!-- ================= LAYOUT PRINCIPAL ================= -->
    <Grid Margin="18">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="10"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="10"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="10"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- ENCABEZADO -->
        <!-- ================================================= -->
        <Grid Grid.Row="0">

            <StackPanel>

                <TextBlock Text="Ingreso de Compras"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock Text="Registra la factura y los productos recibidos del proveedor"
                           FontSize="12.5"
                           Foreground="#6B7280"
                           Margin="0,3,0,0"/>

            </StackPanel>

            <Button Content="📋 Consultar compras"
                    Width="180"
                    Height="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#7C3AED"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnConsultarCompras_Click"/>

        </Grid>

        <!-- ================================================= -->
        <!-- PROVEEDOR Y FACTURA -->
        <!-- ================================================= -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="0.72*"/>

                <ColumnDefinition Width="12"/>

                <ColumnDefinition Width="1.28*"/>

            </Grid.ColumnDefinitions>

            <!-- ================= PROVEEDOR ================= -->
            <Border Grid.Column="0"
                    Padding="12"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="8"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <!-- TÍTULO -->
                    <StackPanel>

                        <TextBlock Text="Proveedor"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>

                        <TextBlock Text="Selecciona el proveedor de la compra"
                                   FontSize="11"
                                   Foreground="#6B7280"
                                   Margin="0,1,0,0"/>

                    </StackPanel>

                    <!-- CAMPOS -->
                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="125"/>

                            <ColumnDefinition Width="8"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="40"/>

                        </Grid.ColumnDefinitions>

                        <!-- NIT -->
                        <StackPanel Grid.Column="0">

                            <Label Content="NIT"
                                   Style="{StaticResource InputLabelStyle}"/>

                            <TextBox x:Name="txtNit"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     ToolTip="NIT del proveedor"/>

                        </StackPanel>

                        <!-- NOMBRE -->
                        <StackPanel Grid.Column="2">

                            <Label Content="Nombre o razón social"
                                   Style="{StaticResource InputLabelStyle}"/>

                            <TextBox x:Name="txtNombreProveedor"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     IsReadOnly="True"
                                     Background="#F9FAFB"
                                     ToolTip="Nombre del proveedor"/>

                        </StackPanel>

                        <!-- BUSCAR -->
                        <Button Grid.Column="3"
                                Content="🔍"
                                Width="32"
                                Height="32"
                                Margin="8,21,0,0"
                                VerticalAlignment="Top"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Buscar proveedor"
                                Click="btn_BuscarProveedor_Click"/>

                    </Grid>

                </Grid>

            </Border>

            <!-- ================= FACTURA ================= -->
            <Border Grid.Column="2"
                    Padding="12"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="8"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <!-- TÍTULO -->
                    <StackPanel>

                        <TextBlock Text="Datos de la factura"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>

                        <TextBlock Text="Información del documento de compra"
                                   FontSize="11"
                                   Foreground="#6B7280"
                                   Margin="0,1,0,0"/>

                    </StackPanel>

                    <!-- CAMPOS -->
                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="1.15*"/>

                            <ColumnDefinition Width="8"/>

                            <ColumnDefinition Width="0.70*"/>

                            <ColumnDefinition Width="8"/>

                            <ColumnDefinition Width="1*"/>

                            <ColumnDefinition Width="8"/>

                            <ColumnDefinition Width="1*"/>

                            <ColumnDefinition Width="8"/>

                            <ColumnDefinition Width="1.10*"/>

                        </Grid.ColumnDefinitions>

                        <!-- NÚMERO DE FACTURA -->
                        <StackPanel Grid.Column="0">

                            <Label Content="No. factura"
                                   Style="{StaticResource InputLabelStyle}"/>

                            <TextBox x:Name="txtNoDocumento"
                                     Style="{StaticResource InputTextBoxStyle}"/>

                        </StackPanel>

                        <!-- SERIE -->
                        <StackPanel Grid.Column="2">

                            <Label Content="Serie"
                                   Style="{StaticResource InputLabelStyle}"/>

                            <TextBox x:Name="txtSerie"
                                     Style="{StaticResource InputTextBoxStyle}"/>

                        </StackPanel>

                        <!-- FECHA EMISIÓN -->
                        <StackPanel Grid.Column="4">

                            <Label Content="Fecha emisión"
                                   Style="{StaticResource InputLabelStyle}"/>

                            <DatePicker x:Name="dpDate"
                                        Height="32"
                                        IsEnabled="True"
                                        />

                        </StackPanel>

                        <!-- FECHA INGRESO -->
                        <StackPanel Grid.Column="6">

                            <Label Content="Fecha ingreso"
                                   Style="{StaticResource InputLabelStyle}"/>

                            <DatePicker x:Name="dpFechaIngreso"
                                        Height="32"
                                        IsEnabled="False"/>

                        </StackPanel>

                        <!-- TIPO DOCUMENTO -->
                        <StackPanel Grid.Column="8">

                            <Label Content="Tipo documento"
                                   Style="{StaticResource InputLabelStyle}"/>

                            <ComboBox x:Name="cbTipoDoc"
                                      Height="32"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

        <!-- ================================================= -->
        <!-- PRODUCTOS -->
        <!-- ================================================= -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="10"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid Margin="15">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="10"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="10"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="10"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- ================= TÍTULO ================= -->
                <StackPanel Grid.Row="0">

                    <TextBlock Text="Productos de la compra"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <TextBlock Text="Busca el producto, ingresa la cantidad y el precio de compra"
                               FontSize="11"
                               Foreground="#6B7280"
                               Margin="0,1,0,0"/>

                </StackPanel>

                <!-- ================================================= -->
                <!-- INGRESO RÁPIDO DE PRODUCTO -->
                <!-- ================================================= -->
                <!-- ================================================= -->
                <!-- INGRESO RÁPIDO DE PRODUCTO -->
                <!-- ================================================= -->
                <Border Grid.Row="2"
        Background="#F9FAFB"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="130"/>

                            <ColumnDefinition Width="12"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="12"/>

                            <ColumnDefinition Width="100"/>

                            <ColumnDefinition Width="12"/>

                            <ColumnDefinition Width="125"/>

                            <ColumnDefinition Width="12"/>

                            <ColumnDefinition Width="42"/>

                            <ColumnDefinition Width="8"/>

                            <ColumnDefinition Width="42"/>

                            <ColumnDefinition Width="8"/>

                            <ColumnDefinition Width="42"/>

                        </Grid.ColumnDefinitions>

                        <!-- CÓDIGO -->
                        <StackPanel Grid.Column="0">

                            <Label Content="Código"
                   Style="{StaticResource InputLabelStyle}"/>

                            <TextBox x:Name="txtCodigoProducto"
                     Style="{StaticResource InputTextBoxStyle}"
                     ToolTip="Código del producto"/>

                        </StackPanel>

                        <!-- NOMBRE -->
                        <StackPanel Grid.Column="2">

                            <Label Content="Nombre del producto"
                   Style="{StaticResource InputLabelStyle}"/>

                            <TextBox x:Name="txtNombreProducto"
                     Style="{StaticResource InputTextBoxStyle}"
                     IsReadOnly="True"
                     Background="#F3F4F6"
                     ToolTip="Nombre del producto seleccionado"/>

                        </StackPanel>

                        <!-- CANTIDAD -->
                        <StackPanel Grid.Column="4">

                            <Label Content="Cantidad"
                   Style="{StaticResource InputLabelStyle}"/>

                            <TextBox x:Name="txtCantidadProducto"
                     Style="{StaticResource InputTextBoxStyle}"
                     HorizontalContentAlignment="Right"
                     ToolTip="Cantidad comprada"/>

                        </StackPanel>

                        <!-- PRECIO -->
                        <StackPanel Grid.Column="6">

                            <Label Content="Precio unitario"
                   Style="{StaticResource InputLabelStyle}"/>

                            <TextBox x:Name="txtPrecioProducto"
                     Style="{StaticResource InputTextBoxStyle}"
                     HorizontalContentAlignment="Right"
                     ToolTip="Precio unitario de compra"/>

                        </StackPanel>

                        <!-- CREAR PRODUCTO -->
                        <Button Grid.Column="8"
                Content="📄"
                Width="38"
                Height="34"
                Margin="0,21,0,0"
                VerticalAlignment="Top"
                Background="#E5E7EB"
                Foreground="#111827"
                BorderThickness="0"
                FontSize="15"
                Cursor="Hand"
                ToolTip="Crear producto"
                Click="btn_CrearProducto_Click"/>

                        <!-- VALIDAR DATOS -->
                        <Button Grid.Column="10"
                Content="✔"
                Width="38"
                Margin="2,21,2,0"
                Background="#F59E0B"
                Foreground="White"
                BorderThickness="0"
                FontSize="16"
                FontWeight="Bold"
                Cursor="Hand"
                ToolTip="Confirmar que los datos del producto sean correctos"
                Click="btn_ConfirmarProducto_Click"/>

                        <!-- AGREGAR PRODUCTO -->
                        <Button Grid.Column="12"
                Content="➕"
                Width="38"
                Height="34"
                Margin="0,21,0,0"
                VerticalAlignment="Top"
                Background="#16A34A"
                Foreground="White"
                BorderThickness="0"
                FontSize="15"
                Cursor="Hand"
                ToolTip="Agregar producto a la compra"
                Click="btn_AgregarProducto_Click"/>

                    </Grid>

                </Border>




                <!-- ================================================= -->
                <!-- DATAGRID DE PRODUCTOS -->
                <!-- ================================================= -->
                <DataGrid x:Name="dgListaProductos"
                          Grid.Row="4"
                          ItemsSource="{Binding DetalleCompraModelView}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          RowHeight="36"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5E7EB"
                          VerticalGridLinesBrush="Transparent"
                          BorderThickness="0"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#F9FAFB"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FontSize="12.5">

                    <DataGrid.Columns>

                        <!-- BUSCAR O CAMBIAR PRODUCTO -->
                        <DataGridTemplateColumn Header=""
                                                Width="55">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Button Content="🔍"
                                            Width="30"
                                            Height="27"
                                            Background="#DBEAFE"
                                            Foreground="#1D4ED8"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="Buscar o cambiar producto"
                                            Click="btn_CambiarProducto_Click"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <!-- ID -->
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Producto_Id}"
                                            IsReadOnly="True"
                                            Width="65"/>

                        <!-- PRODUCTO -->
                        <DataGridTextColumn Header="Producto"
                                            Binding="{Binding Producto.Nombre}"
                                            IsReadOnly="True"
                                            Width="*"/>

                        <!-- CANTIDAD -->
                        <DataGridTextColumn Header="Cantidad"
                                            Binding="{Binding Cantidad, StringFormat=Q{0:N2}}"
                                            Width="105"/>

                        <!-- PRECIO -->
                        <DataGridTextColumn Header="Precio unitario"
                                            Binding="{Binding Precio_Unitario, StringFormat=Q {0:N2}}"
                                            Width="135"/>

                        <!-- SUBTOTAL -->
                        <DataGridTextColumn Header="Subtotal"
                                            Binding="{Binding SubtotalCalculado, StringFormat=Q {0:N2}}"
                                            IsReadOnly="True"
                                            Width="135"/>

                        <!-- ELIMINAR -->
                        <DataGridTemplateColumn Header=""
                                                Width="60">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Button Content="🗑"
                                            Width="30"
                                            Height="27"
                                            Background="#FEE2E2"
                                            Foreground="#B91C1C"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="Eliminar producto"
                                            Click="btn_EliminarProducto_Click"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

                <!-- ================================================= -->
                <!-- TOTAL -->
                <!-- ================================================= -->
                <Border Grid.Row="6"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <TextBlock Text="Total de la compra:"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="txtTotalCompra"
                                   Text="Q 0.00"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- BOTONES DE ACCIÓN -->
        <!-- ================================================= -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancelar"
                    Width="120"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="btnCancelar_Click"/>

            <Button Content="💾 Guardar compra"
                    Width="165"
                    Style="{StaticResource SuccessButtonStyle}"
                    Click="btnGuardar_Click"/>

        </StackPanel>

    </Grid>

</UserControl>