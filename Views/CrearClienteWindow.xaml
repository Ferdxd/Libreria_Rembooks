<Window x:Class="Libreria_Rembooks.Views.CrearClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar cliente"
        Height="560"
        Width="720"
        MinHeight="520"
        MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Window.Resources>

        <!-- ================= CAMPOS DE TEXTO ================= -->
        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#111827"/>

            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

        </Style>

        <!-- ================= ETIQUETAS ================= -->
        <Style x:Key="InputLabelStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#374151"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="12.5"/>

            <Setter Property="Margin"
                    Value="0,0,0,6"/>

        </Style>

        <!-- ================= BOTÓN PRINCIPAL ================= -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Background"
                    Value="#16A34A"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#15803D"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#166534"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================= BOTÓN SECUNDARIO ================= -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Background"
                    Value="#E5E7EB"/>

            <Setter Property="Foreground"
                    Value="#111827"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D1D5DB"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="74"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- ENCABEZADO -->
        <!-- ================================================= -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Padding="24,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="46"
                        Height="46"
                        CornerRadius="23"
                        Background="#DBEAFE"
                        VerticalAlignment="Center">

                    <TextBlock Text="👤"
                               FontSize="21"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Registrar nuevo cliente"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <TextBlock Text="Ingresa la información necesaria para crear el cliente"
                               FontSize="12.5"
                               Foreground="#6B7280"
                               Margin="0,3,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- CONTENIDO -->
        <!-- ================================================= -->
        <Grid Grid.Row="1"
              Margin="24,20">

            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TÍTULO DE SECCIÓN -->
                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Información del cliente"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>

                        <TextBlock Text="Los campos marcados con * son obligatorios"
                                   FontSize="11.5"
                                   Foreground="#6B7280"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                    <!-- NIT Y TELÉFONO -->
                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="NIT *"
                                       Style="{StaticResource InputLabelStyle}"/>

                            <TextBox x:Name="txtNit"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     MaxLength="20"
                                     ToolTip="Ingrese el NIT del cliente"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Teléfono"
                                       Style="{StaticResource InputLabelStyle}"/>

                            <TextBox x:Name="txtTelefono"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     MaxLength="20"
                                     ToolTip="Ingrese el teléfono del cliente"/>

                        </StackPanel>

                    </Grid>

                    <!-- NOMBRE -->
                    <StackPanel Grid.Row="4">

                        <TextBlock Text="Nombre completo o razón social *"
                                   Style="{StaticResource InputLabelStyle}"/>

                        <TextBox x:Name="txtNombre"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 MaxLength="150"
                                 ToolTip="Ingrese el nombre completo o razón social"/>

                    </StackPanel>

                    <!-- DIRECCIÓN -->
                    <StackPanel Grid.Row="6">

                        <TextBlock Text="Dirección"
                                   Style="{StaticResource InputLabelStyle}"/>

                        <TextBox x:Name="txtDireccion"
                                 Height="70"
                                 Padding="10,8"
                                 VerticalContentAlignment="Top"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MaxLength="250"
                                 Background="White"
                                 Foreground="#111827"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1"
                                 FontSize="13"
                                 ToolTip="Ingrese la dirección del cliente"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

        <!-- ================================================= -->
        <!-- PIE Y BOTONES -->
        <!-- ================================================= -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="24,0">

            <Grid>

                <TextBlock Text="Verifica que la información sea correcta antes de guardar."
                           Foreground="#6B7280"
                           FontSize="11.5"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button Content="Cancelar"
                            Width="110"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="btnCancelar_Click"/>

                    <Button Content="💾  Guardar cliente"
                            Width="160"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="btnGuardar_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>