<Window x:Class="Libreria_Rembooks.Views.BuscarProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar Producto"
        Height="650"
        Width="1024"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Margin="0,0,0,18">

            <TextBlock Text="Selección de Producto"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#111827"/>

            <TextBlock Text="Busque un producto por código o nombre y complete los datos de la compra."
                       Margin="0,5,0,0"
                       Foreground="#6B7280"
                       FontSize="13"/>

        </StackPanel>

        <!-- FILTROS -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="18"
                Margin="0,0,0,15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Código -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="2">

                    <TextBlock Text="Código"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="txtCodigo"
                             Height="34"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Nombre -->
                <StackPanel Grid.Column="2" Grid.ColumnSpan="2">

                    <TextBlock Text="Nombre"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="txtNombre"
                             Height="34"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Buscar -->
                <Button Grid.Column="4"
                        Content="🔍 Buscar"
                        Width="120"
                        Height="34"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="btnBuscar_Click"/>

            </Grid>

        </Border>

        <!-- TABLA -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10">

            <DataGrid x:Name="dgProductos"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      RowHeight="36"
                      SelectionChanged="dgProductos_SelectionChanged">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Código"
                                        Binding="{Binding Codigo}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Nombre del Producto"
                                        Binding="{Binding Nombre}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Precio Compra"
                                        Binding="{Binding PrecioCompra,StringFormat=N2}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Precio Compra"
                                        Binding="{Binding PrecioPromedio,StringFormat=N2}"
                                        Width="140"/>
                    <DataGridTextColumn Header="Precio Venta"
                                        Binding="{Binding PrecioVenta,StringFormat=N2}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Existencia"
                                        Binding="{Binding Stock}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Unidad"
                                        Binding="{Binding UnidadMedida}"
                                        Width="120"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- DATOS DEL PRODUCTO -->
        <Border Grid.Row="3"
                Margin="0,15,0,0"
                Background="White"
                CornerRadius="10"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>



            </Grid>

        </Border>

        <!-- BOTONES -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">

            <Button x:Name="BtnCancelar"
                    Content="Cancelar"
                    Width="120"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="#E5E7EB"
                    Foreground="#111827"
                    BorderThickness="0"
                    Click="btn_Cancelar_Click"/>

            <Button x:Name="BtnAgregar"
                    Content="Agregar Producto"
                    Width="170"
                    Height="38"
                    Background="#16A34A"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="BtnAgregar_Click"/>

        </StackPanel>

    </Grid>
</Window>