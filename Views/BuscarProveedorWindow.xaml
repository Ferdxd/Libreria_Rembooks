<Window x:Class="Libreria_Rembooks.Views.BuscarProveedorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar Proveedor"
        Height="550"
        Width="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <TextBlock Grid.Row="0"
                   Text="Seleccionar proveedor"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#111827"
                   Margin="0,0,0,20"/>

        <!-- BUSCADOR -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="15"
                Margin="0,0,0,15">

            <StackPanel>

                <TextBlock Text="Buscar proveedor"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,0,10"/>

                <DockPanel>

                    <TextBox x:Name="txtBuscar"
                             Height="34"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             Margin="0,0,10,0"/>

                    <Button Content="🔍 Buscar"
                            Width="110"
                            Height="34"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="btnBuscar"/>
                </DockPanel>

            </StackPanel>

        </Border>

        <!-- TABLA -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10">

            <DataGrid x:Name="dgProveedor"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      RowHeight="32"
                      HeadersVisibility="Column">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="NIT"
                                        Binding="{Binding Nit}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Razón Social"
                                        Binding="{Binding Razon_Social}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Dirección"
                                        Binding="{Binding Direccion}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Teléfono"
                                        Binding="{Binding Telefono}"
                                        Width="120"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- BOTONES -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button x:Name="BtnCancelar"
                    Content="Cancelar"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#E5E7EB"
                    Foreground="#111827"
                    BorderThickness="0"
                    Click="BtnCancelar_Click"/>

            <Button x:Name="BtnAgregar"
                    Content="Seleccionar"
                    Width="140"
                    Height="35"
                    Background="#16A34A"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="BtnAgregar_Click"/>

        </StackPanel>

    </Grid>

</Window>