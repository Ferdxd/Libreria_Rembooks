<UserControl x:Class="Libreria_Rembooks.Views.CategoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Libreria_Rembooks.Views"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Background="#F3F4F6">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Margin="0,0,0,16">

            <TextBlock Text="Gestión de Categorías"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#111827"/>

            <TextBlock Text="Administre las categorías utilizadas para organizar los productos del sistema."
                       Margin="0,4,0,0"
                       FontSize="13"
                       Foreground="#6B7280"/>

        </StackPanel>

        <!-- FORMULARIO -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Información de Categoría"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="#374151"
                           Margin="0,0,0,12"/>

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nombre -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Nombre"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="txtNombre"
                                 Height="34"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <!-- Descripción -->
                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Descripción"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="txtDescripcion"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 TextWrapping="Wrap"/>

                    </StackPanel>

                </Grid>

                <!-- Botones -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0">

                    <Button x:Name="Btn_Guardar"
                            Content="Guardar"
                            Width="115"
                            Height="34"
                            Margin="0,0,8,0"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Click="Btn_Guardar_Click"/>

                    <Button x:Name="Btn_GuardarCambios"
                            Content="Guardar Cambios"
                            Width="145"
                            Height="34"
                            Margin="0,0,8,0"
                            Background="#16A34A"
                            Foreground="White"
                            BorderThickness="0"
                            Click="Btn_GuardarCambios_Click"/>

                    <Button x:Name="Btn_Actualizar"
                            Content="Actualizar"
                            Width="115"
                            Height="34"
                            Margin="0,0,8,0"
                            Background="#7C3AED"
                            Foreground="White"
                            BorderThickness="0"/>

                    <Button x:Name="Btn_Limpiar"
                            Content="Limpiar"
                            Width="115"
                            Height="34"
                            Margin="0,0,8,0"
                            Background="#E5E7EB"
                            Foreground="#111827"
                            BorderThickness="0"
                            Click="Btn_Limpiar_Click"/>

                    <Button x:Name="Btn_Cancelar"
                            Content="Cancelar"
                            Width="115"
                            Height="34"
                            Background="#DC2626"
                            Foreground="White"
                            BorderThickness="0"
                            Click="Btn_Cancelar_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- BUSCADOR -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,12">

            <DockPanel>

                <TextBlock Text="Buscar categoría:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,10,0"/>

                <Button Content="Buscar"
                        DockPanel.Dock="Right"
                        Width="100"
                        Height="34"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Click="Btn_Buscar_Click"/>

                <TextBox x:Name="txtBuscar"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"/>

            </DockPanel>

        </Border>

        <!-- DATAGRID -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">

            <DataGrid x:Name="dgCategorias"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      RowHeight="38"
                      FontSize="13"
                      HeadersVisibility="Column">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Nombre"
                                        Binding="{Binding Nombre}"
                                        Width="250"/>

                    <DataGridTextColumn Header="Descripción"
                                        Binding="{Binding Descripcion}"
                                        Width="*"/>

                    <DataGridTemplateColumn Header="Acciones"
                                            Width="130">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Editar"
                                        Width="85"
                                        Height="28"
                                        Background="#F59E0B"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="Btn_Editar_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>