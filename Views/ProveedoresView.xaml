<UserControl x:Class="Libreria_Rembooks.Views.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Libreria_Rembooks.Views"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Background="#F3F4F6">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Margin="0,0,0,16">

            <TextBlock Text="Gestión de Proveedores"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#111827"/>

            <TextBlock Text="Administre la información de los proveedores registrados en el sistema."
                       Margin="0,4,0,0"
                       FontSize="13"
                       Foreground="#6B7280"/>

        </StackPanel>

        <!-- FORMULARIO -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Información del Proveedor"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="#374151"
                           Margin="0,0,0,12"/>

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Razón Social -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Razón Social"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="txtRazonSocial"
                                 Height="34"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- NIT -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NIT"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="txtNit"
                                 Height="34"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Dirección -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Dirección"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="txtDireccion"
                                 Height="34"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Teléfono -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Teléfono"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="txtTelefono"
                                 Height="34"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                </Grid>

                <!-- BOTONES -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0">

                    <Button x:Name="btn_Guardar"
                            Content="Guardar"
                            Width="115"
                            Height="34"
                            Margin="0,0,8,0"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Click="btn_Guardar_Click"/>

                    <Button x:Name="btn_GuardarCambios"
                            Content="Guardar Cambios"
                            Width="145"
                            Height="34"
                            Margin="0,0,8,0"
                            Background="#16A34A"
                            Foreground="White"
                            BorderThickness="0"
                            Click="btn_GuardarCambios_Click"/>

                    <Button x:Name="btn_Limpiar"
                            Content="Limpiar"
                            Width="115"
                            Height="34"
                            Margin="0,0,8,0"
                            Background="#E5E7EB"
                            Foreground="#111827"
                            BorderThickness="0"
                            Click="btn_Limpiar_Click"/>

                    <Button x:Name="btn_Cancelar"
                            Content="Cancelar"
                            Width="115"
                            Height="34"
                            Background="#DC2626"
                            Foreground="White"
                            BorderThickness="0"
                            Click="btn_Cancelar_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- BUSCADOR -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,12">

            <DockPanel>

                <TextBlock Text="Buscar proveedor:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,10,0"/>

                <Button x:Name="btn_Buscar"
                        Content="Buscar"
                        DockPanel.Dock="Right"
                        Width="100"
                        Height="34"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Click="btn_Buscar_Click"/>

                <TextBox x:Name="txtBuscar"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"/>

            </DockPanel>

        </Border>

        <!-- DATAGRID -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">

            <DataGrid x:Name="dgProveedores"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      RowHeight="38"
                      FontSize="13"
                      HeadersVisibility="Column">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Razón Social"
                                        Binding="{Binding Razon_Social}"
                                        Width="*"/>

                    <DataGridTextColumn Header="NIT"
                                        Binding="{Binding Nit}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Dirección"
                                        Binding="{Binding Direccion}"
                                        Width="250"/>

                    <DataGridTextColumn Header="Teléfono"
                                        Binding="{Binding Telefono}"
                                        Width="130"/>

                    <DataGridTemplateColumn Header="Acciones"
                                            Width="130">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <Button Content="Editar"
                                        Width="85"
                                        Height="28"
                                        Background="#F59E0B"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="btn_Editar_Click"/>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>