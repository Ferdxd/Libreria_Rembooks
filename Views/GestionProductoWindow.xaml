<Window x:Class="Libreria_Rembooks.Views.GestionProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión del Producto"
        Height="780"
        Width="820"
        MinHeight="600"
        MinWidth="760"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#F3F4F6">

    <Window.Resources>

        <!-- Estilo general para TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Estilo general para ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Estilo de etiquetas -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Botón principal -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Botón secundario -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Botón compacto -->
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================= -->
        <!-- ENCABEZADO -->
        <!-- ========================================= -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Gestión del Producto"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,7,0,0">

                        <TextBlock x:Name="txtResumenNombre"
                                   Text="Cuaderno universitario"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#4B5563"/>

                        <TextBlock Text="  |  Código: "
                                   FontSize="13"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="txtResumenCodigo"
                                   Text="100245"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#4B5563"/>

                        <TextBlock Text="  |  Existencia: "
                                   FontSize="13"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="txtResumenExistencia"
                                   Text="35 unidades"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#4B5563"/>

                    </StackPanel>

                </StackPanel>

                <!-- Estado -->
                <Border Grid.Column="1"
                        Background="#DCFCE7"
                        CornerRadius="16"
                        Padding="12,6"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#16A34A"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0"/>

                        <TextBlock x:Name="txtEstadoProducto"
                                   Text="Activo"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#166534"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- ========================================= -->
        <!-- CONTENIDO -->
        <!-- ========================================= -->
        <ScrollViewer Grid.Row="1"
                      VerticalAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly">

            <StackPanel>

                <!-- ========================================= -->
                <!-- INFORMACIÓN GENERAL -->
                <!-- ========================================= -->
                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22"
                        Margin="0,0,0,16">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="INFORMACIÓN GENERAL"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#374151"
                                   Margin="0,0,0,18"/>

                        <Grid Grid.Row="1">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Nombre -->
                            <StackPanel Grid.Row="0"
                                        Grid.Column="0">

                                <TextBlock Text="Nombre"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="txtNombre"/>

                            </StackPanel>

                            <!-- Código -->
                            <StackPanel Grid.Row="0"
                                        Grid.Column="2">

                                <TextBlock Text="Código"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="txtCodigo"/>

                            </StackPanel>

                            <!-- Categoría -->
                            <StackPanel Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3">

                                <TextBlock Text="Categoría"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <ComboBox x:Name="cbCategoria"
                                          DisplayMemberPath="Nombre"
                                          SelectedValuePath="Id"/>

                            </StackPanel>

                            <!-- Unidad -->
                            <StackPanel Grid.Row="4"
                                        Grid.Column="0">

                                <TextBlock Text="Unidad de medida"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="txtUnidadMedida"/>

                            </StackPanel>

                            <!-- Marca -->
                            <StackPanel Grid.Row="4"
                                        Grid.Column="2">

                                <TextBlock Text="Marca"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="txtMarca"/>

                            </StackPanel>

                            <!-- Descripción -->
                            <StackPanel Grid.Row="6"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3">

                                <TextBlock Text="Descripción"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="txtDescripcion"
                                         Height="82"
                                         Padding="10,8"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"/>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>

                <!-- ========================================= -->
                <!-- PRECIOS Y RENTABILIDAD -->
                <!-- ========================================= -->
                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22"
                        Margin="0,0,0,16">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="PRECIOS Y RENTABILIDAD"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#374151"
                                   Margin="0,0,0,18"/>

                        <!-- Tarjetas de costos -->
                        <Grid Grid.Row="1">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Costo promedio -->
                            <Border Grid.Column="0"
                                    Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="16">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="Costo promedio"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#6B7280"/>

                                        <TextBlock x:Name="txtCostoPromedio"
                                                   Text="0"
                                                   Margin="0,6,0,0"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#111827"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="🔒"
                                               FontSize="14"
                                               VerticalAlignment="Top"/>

                                </Grid>

                            </Border>

                            <!-- Última compra -->
                            <Border Grid.Column="2"
                                    Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="16">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="Última compra"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#6B7280"/>

                                        <TextBlock x:Name="txtUltimaCompra"
                                                   Text="0"
                                                   Margin="0,6,0,0"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#111827"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="🔒"
                                               FontSize="14"
                                               VerticalAlignment="Top"/>

                                </Grid>

                            </Border>

                        </Grid>

                        <!-- Precio y aumento -->
                        <Grid Grid.Row="3">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Precio venta -->
                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Precio de venta"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="txtPrecioVenta"
                                         Text="12.50"
                                         TextChanged="txtPrecioVenta_TextChanged"/>

                            </StackPanel>

                            <!-- Porcentaje -->
                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Calcular por aumento (%)"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="btnDisminuirAumento"
                                            Grid.Column="0"
                                            Content="−"
                                            Style="{StaticResource CompactButtonStyle}"
                                            Click="btn_DisminuirAumento_Click"/>

                                    <TextBox x:Name="txtPorcentajeAumento"
                                             Grid.Column="1"
                                             Text="0"
                                             Height="34"
                                             Margin="8,0"
                                             Padding="0"
                                             TextAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             TextChanged="txtPorcentajeAumento_TextChanged"/>

                                    <Button x:Name="btnAumentarAumento"
                                            Grid.Column="2"
                                            Content="+"
                                            Style="{StaticResource CompactButtonStyle}"
                                            Click="btn_AumentarAumento_Click" HorizontalAlignment="Right" Width="34"/>

                                </Grid>

                            </StackPanel>

                        </Grid>

                        <!-- Ganancia -->
                        <Border Grid.Row="5"
                                Background="#F0FDF4"
                                BorderBrush="#BBF7D0"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="15">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Ganancia estimada"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#166534"/>

                                    <TextBlock Text="Diferencia calculada entre el costo promedio y el precio de venta."
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#4B5563"/>

                                </StackPanel>

                                <TextBlock x:Name="txtGananciaEstimada"
                                           Grid.Column="1"
                                           Text="Q2.50"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#16A34A"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                    </Grid>

                </Border>

                <!-- ========================================= -->
                <!-- PRESENTACIONES -->
                <!-- ========================================= -->
                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,16">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <TextBlock Text="▸"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#4B5563"
                                           Margin="0,0,8,0"/>

                                <StackPanel>

                                    <TextBlock Text="Presentaciones y unidades de venta"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#374151"/>

                                    <TextBlock Text="Configure cajas, paquetes, docenas u otras presentaciones del producto."
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </StackPanel>

                            <Button x:Name="btnAgregarPresentacion"
                                    Grid.Column="1"
                                    Content="+ Agregar presentación"
                                    Height="34"
                                    Padding="14,0"
                                    Background="#EFF6FF"
                                    Foreground="#1D4ED8"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"/>

                        </Grid>

                        <Border Grid.Row="1"
                                Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,16,0,0">

                            <TextBlock Text="No hay presentaciones configuradas para este producto."
                                       FontSize="12"
                                       Foreground="#6B7280"
                                       HorizontalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>

                <!-- ========================================= -->
                <!-- AUDITORÍA -->
                <!-- ========================================= -->
                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Creado"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"/>

                            <TextBlock x:Name="txtFechaCreacion"
                                       Text="20/07/2026"
                                       Margin="0,5,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Última modificación"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"/>

                            <TextBlock x:Name="txtFechaModificacion"
                                       Text="15/08/2026"
                                       Margin="0,5,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>

                        </StackPanel>

                        <StackPanel Grid.Column="4">

                            <TextBlock Text="Creado por"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"/>

                            <TextBlock x:Name="txtUsuarioCreacion"
                                       Text="Administrador"
                                       Margin="0,5,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>

                        </StackPanel>

                    </Grid>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- ========================================= -->
        <!-- BOTONES -->
        <!-- ========================================= -->
        <Border Grid.Row="2"
                Background="#F3F4F6"
                Padding="0,16,0,0"
                Panel.ZIndex="10">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="btnCancelar"
                        Content="Cancelar"
                        Width="120"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="btn_Cancelar_Click"/>

                <Button x:Name="btnGuardarCambios"
                        Content="Guardar cambios"
                        Width="160"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="btn_GuardarCambios_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>